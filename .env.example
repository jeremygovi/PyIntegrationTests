# Explicitly opt in with --env-file .env; empty placeholders are not credentials.
PYINTEGRATIONTESTS_CASE_SECONDS=900
PYINTEGRATIONTESTS_OBSERVATION_SECONDS=15
PYINTEGRATIONTESTS_CLEANUP_SECONDS=300
PYINTEGRATIONTESTS_ARTIFACTS_DIRECTORY=.pyintegrationtests/runs
CLOUDFLARE_API_TOKEN=
