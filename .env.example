# AWS_CONFIG_FILE=/credentials/aws-config
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# KUBECONFIG=/credentials/kubeconfig
# FIXTURE_JWT_KEY=your-local-fixture-private-key
